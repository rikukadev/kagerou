{{generatedBy "#"}}
AWSTemplateFormatVersion: "2010-09-09"
Description: >
  Preview environment for {{.Project}} (generated by kagerou init, compute: ecs).
  One Fargate service behind the shared ALB (deploy/alb-base.yaml). Base values
  are read via SSM dynamic references, so nothing has to be wired by hand.

# アプリに届けたい値は Env<Key>(kagerou CONTRACT §4)。共有 ALB 側の値は
# ベースが書いた SSM(/kagerou/base/{{.Project}}/alb_*)を {{"{{"}}resolve:ssm{{"}}"}} で読む。
Parameters:
  # サブネットだけは {{"{{"}}resolve:ssm{{"}}"}} で読めない。動的参照は「文字列を書く場所」
  # でしか展開されず、Fn::Split の中では素の文字列のまま渡ってしまう
  # (cfn-lint E1018)。リスト型の SSM パラメータとして受け取るのが正解。
  # Env* ではないので kagerou は値を渡さない(Default の SSM パスから解決される)。
  BaseSubnets:
    Type: AWS::SSM::Parameter::Value<List<AWS::EC2::Subnet::Id>>
    Default: /kagerou/base/{{.Project}}/alb_subnets
    Description: Task subnets, resolved from the shared ALB base at deploy time
  EnvKagerouEnv:
    Type: String
    Description: 'Environment name. Injected via `KAGEROU_ENV: "{name}"` in kagerou.yaml'
  EnvKagerouUrl:
    Type: String
    Description: Environment URL (from url_template). The ALB host header is derived from it
  EnvImageUri:
    Type: String
    Description: 'Container image for this environment. CI passes --env IMAGE_URI=<ecr>:<name>'
  EnvRulePriority:
    Type: Number
    Description: >
      Listener-rule priority; must be unique on the shared listener. kagerou
      reserves a free one at up time (#189). Pass --env RULE_PRIORITY to pin it.
{{- if .Wants.Redis}}
  EnvRedisUrl:
    Type: String
    Default: ""
    Description: Shared redis endpoint (set via env REDIS_URL in kagerou.yaml)
{{- end}}
{{- if .Wants.OpenSearch}}
  EnvOpensearchUrl:
    Type: String
    Default: ""
    Description: Shared opensearch endpoint (set via env OPENSEARCH_URL in kagerou.yaml)
{{- end}}

Resources:
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub "/kagerou/${EnvKagerouEnv}"
      RetentionInDays: 3

  ExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      PermissionsBoundary: !Sub "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/{{.Project}}-boundary"
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: ecs-tasks.amazonaws.com }
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
{{- if or .Wants.DynamoDB .Wants.SNS .Wants.SQS .Wants.S3}}

  # アプリがランタイムで使う権限(検出した依存のぶんだけ)
  TaskRole:
    Type: AWS::IAM::Role
    Properties:
      PermissionsBoundary: !Sub "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/{{.Project}}-boundary"
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: ecs-tasks.amazonaws.com }
            Action: sts:AssumeRole
      Policies:
        - PolicyName: app
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
{{- if .Wants.DynamoDB}}
              - Effect: Allow
                Action: [dynamodb:GetItem, dynamodb:PutItem, dynamodb:UpdateItem, dynamodb:DeleteItem, dynamodb:Query, dynamodb:Scan, dynamodb:BatchGetItem, dynamodb:BatchWriteItem]
                Resource: [!GetAtt AppTable.Arn, !Sub "${AppTable.Arn}/index/*"]
{{- end}}
{{- if .Wants.SNS}}
              - Effect: Allow
                Action: [sns:Publish]
                Resource: !Ref AppTopic
{{- end}}
{{- if .Wants.SQS}}
              - Effect: Allow
                Action: [sqs:SendMessage, sqs:ReceiveMessage, sqs:DeleteMessage, sqs:GetQueueAttributes]
                Resource: !GetAtt AppQueue.Arn
{{- end}}
{{- if .Wants.S3}}
              - Effect: Allow
                Action: [s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket]
                Resource: [!GetAtt AppBucket.Arn, !Sub "${AppBucket.Arn}/*"]
{{- end}}
{{- end}}

  TaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub "kagerou-${EnvKagerouEnv}"
      Cpu: "256"
      Memory: "512"
      NetworkMode: awsvpc
      RequiresCompatibilities: [FARGATE]
      ExecutionRoleArn: !GetAtt ExecutionRole.Arn
{{- if or .Wants.DynamoDB .Wants.SNS .Wants.SQS .Wants.S3}}
      TaskRoleArn: !GetAtt TaskRole.Arn
{{- end}}
      ContainerDefinitions:
        - Name: app
          Image: !Ref EnvImageUri
          PortMappings:
            - ContainerPort: {{if .Port}}{{.Port}}{{else}}8080{{end}}
          Environment:
            - { Name: PORT, Value: "{{if .Port}}{{.Port}}{{else}}8080{{end}}" }
            - { Name: KAGEROU_ENV, Value: !Ref EnvKagerouEnv }
            - { Name: KAGEROU_URL, Value: !Ref EnvKagerouUrl }
{{- if .Wants.DynamoDB}}
            - { Name: TABLE_NAME, Value: !Ref AppTable }
{{- end}}
{{- if .Wants.SNS}}
            - { Name: TOPIC_ARN, Value: !Ref AppTopic }
{{- end}}
{{- if .Wants.SQS}}
            - { Name: QUEUE_URL, Value: !Ref AppQueue }
{{- end}}
{{- if .Wants.S3}}
            - { Name: BUCKET_NAME, Value: !Ref AppBucket }
{{- end}}
{{- if .Wants.Redis}}
            - { Name: REDIS_URL, Value: !Ref EnvRedisUrl }
{{- end}}
{{- if .Wants.OpenSearch}}
            - { Name: OPENSEARCH_URL, Value: !Ref EnvOpensearchUrl }
{{- end}}
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: !Ref LogGroup
              awslogs-region: !Ref AWS::Region
              awslogs-stream-prefix: app

  TargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      VpcId: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_vpc_id{{"}}"}}"
      Port: {{if .Port}}{{.Port}}{{else}}8080{{end}}
      Protocol: HTTP
      TargetType: ip
      HealthCheckPath: /healthz
      HealthCheckIntervalSeconds: 10
      HealthyThresholdCount: 2
      # 環境は消えるので、抜くのを待たない(down を速くする)
      TargetGroupAttributes:
        - Key: deregistration_delay.timeout_seconds
          Value: "5"

  # 共有リスナーに自分のホスト名だけを横取りするルールを足す。
  # ALB 本体は触らない(= 他の環境に影響しない)
  ListenerRule:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_listener_arn{{"}}"}}"
      Priority: !Ref EnvRulePriority
      Conditions:
        - Field: host-header
          # https://pr-42.myapp.example.com → pr-42.myapp.example.com
          Values: [!Select [1, !Split ["//", !Ref EnvKagerouUrl]]]
      Actions:
        - Type: forward
          TargetGroupArn: !Ref TargetGroup

  Service:
    Type: AWS::ECS::Service
    DependsOn: ListenerRule
    Properties:
      Cluster: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_cluster{{"}}"}}"
      TaskDefinition: !Ref TaskDefinition
      DesiredCount: 1
      LaunchType: FARGATE
      NetworkConfiguration:
        AwsvpcConfiguration:
          # ベースの判断に従う: 既定は公開サブネット + public IP(NAT を立てない)。
          # alb-base に TaskSubnetIds(プライベート)を渡した運用なら DISABLED になる
          AssignPublicIp: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_assign_public_ip{{"}}"}}"
          Subnets: !Ref BaseSubnets
          SecurityGroups: ["{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_task_security_group{{"}}"}}"]
      LoadBalancers:
        - ContainerName: app
          ContainerPort: {{if .Port}}{{.Port}}{{else}}8080{{end}}
          TargetGroupArn: !Ref TargetGroup
{{- if .Wants.DynamoDB}}

  # 依存に DynamoDB クライアントを検出したので同梱(on-demand = アイドル $0)
  AppTable:
    Type: AWS::DynamoDB::Table
    Properties:
      BillingMode: PAY_PER_REQUEST
      AttributeDefinitions:
        - AttributeName: id # TODO: match your real key schema
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
{{- end}}
{{- if .Wants.SNS}}

  # 依存に SNS クライアントを検出したので同梱(アイドル $0)。他アプリの環境と
  # 連動させる場合は、Topic 名を環境名から導ける形にしておくと発見しやすい
  AppTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: !Sub "{{.Project}}-${EnvKagerouEnv}-events"
{{- end}}
{{- if .Wants.SQS}}

  # 依存に SQS クライアントを検出したので同梱(アイドル $0)
  AppQueue:
    Type: AWS::SQS::Queue
{{- end}}
{{- if and .Wants.SNS .Wants.SQS}}

  # SNS と SQS の両方を使うので、Topic → Queue の配線も同梱(fan-out の定型)
  AppQueueSubscription:
    Type: AWS::SNS::Subscription
    Properties:
      Protocol: sqs
      TopicArn: !Ref AppTopic
      Endpoint: !GetAtt AppQueue.Arn
  AppQueuePolicy:
    Type: AWS::SQS::QueuePolicy
    Properties:
      Queues: [!Ref AppQueue]
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: sns.amazonaws.com }
            Action: sqs:SendMessage
            Resource: !GetAtt AppQueue.Arn
            Condition:
              ArnEquals: { "aws:SourceArn": !Ref AppTopic }
{{- end}}
{{- if .Wants.S3}}

  # 依存に S3 クライアントを検出したので、アプリデータ用バケットを同梱
  AppBucket:
    Type: AWS::S3::Bucket
{{- end}}

Outputs:
  KagerouUrl:
    Value: !Ref EnvKagerouUrl
  ServiceName:
    Value: !GetAtt Service.Name
