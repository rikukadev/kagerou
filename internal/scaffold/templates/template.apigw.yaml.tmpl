AWSTemplateFormatVersion: "2010-09-09"
Description: >
  Preview environment for {{.Project}} (generated by kagerou init, compute: apigateway).
  One Fargate service reached through the shared VPC Link (deploy/apigw-base.yaml),
  fronted by its own HTTP API. Base values are read via SSM dynamic references.

# アプリに届けたい値は Env<Key>(kagerou CONTRACT §4)。共有ベース側の値は
# apigw-base が書いた SSM(/kagerou/base/{{.Project}}/apigw_*)を
# {{"{{"}}resolve:ssm{{"}}"}} で読む。
#
# ALB 構成との違いは入口だけで、タスクの中身は同じ。固定費のある ALB を持たない
# 代わりに、HTTP API のリクエスト上限(30 秒)がかかる。
Parameters:
  # サブネットだけは {{"{{"}}resolve:ssm{{"}}"}} で読めない。動的参照は「文字列を書く場所」
  # でしか展開されず、Fn::Split の中では素の文字列のまま渡ってしまう
  # (cfn-lint E1018)。リスト型の SSM パラメータとして受け取るのが正解。
  # Env* ではないので kagerou は値を渡さない(Default の SSM パスから解決される)。
  BaseSubnets:
    Type: AWS::SSM::Parameter::Value<List<AWS::EC2::Subnet::Id>>
    Default: /kagerou/base/{{.Project}}/apigw_subnets
    Description: Task subnets, resolved from the shared API Gateway base at deploy time
  EnvKagerouEnv:
    Type: String
    Description: 'Environment name. Injected via `KAGEROU_ENV: "{name}"` in kagerou.yaml'
  EnvKagerouUrl:
    Type: String
    Description: Environment URL (from url_template). The custom domain is derived from it
  EnvImageUri:
    Type: String
    Description: 'Container image for this environment. CI passes --env IMAGE_URI=<ecr>:<name>'
{{- if .Wants.Redis}}
  EnvRedisUrl:
    Type: String
    Default: ""
    Description: Shared redis endpoint (set via env REDIS_URL in kagerou.yaml)
{{- end}}
{{- if .Wants.OpenSearch}}
  EnvOpensearchUrl:
    Type: String
    Default: ""
    Description: Shared opensearch endpoint (set via env OPENSEARCH_URL in kagerou.yaml)
{{- end}}

Resources:
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub "/kagerou/${EnvKagerouEnv}"
      RetentionInDays: 3

  ExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: ecs-tasks.amazonaws.com }
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
{{- if or .Wants.DynamoDB .Wants.SNS .Wants.SQS .Wants.S3}}

  # アプリがランタイムで使う権限(検出した依存のぶんだけ)
  TaskRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: ecs-tasks.amazonaws.com }
            Action: sts:AssumeRole
      Policies:
        - PolicyName: app
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
{{- if .Wants.DynamoDB}}
              - Effect: Allow
                Action: [dynamodb:GetItem, dynamodb:PutItem, dynamodb:UpdateItem, dynamodb:DeleteItem, dynamodb:Query, dynamodb:Scan, dynamodb:BatchGetItem, dynamodb:BatchWriteItem]
                Resource: [!GetAtt AppTable.Arn, !Sub "${AppTable.Arn}/index/*"]
{{- end}}
{{- if .Wants.SNS}}
              - Effect: Allow
                Action: [sns:Publish]
                Resource: !Ref AppTopic
{{- end}}
{{- if .Wants.SQS}}
              - Effect: Allow
                Action: [sqs:SendMessage, sqs:ReceiveMessage, sqs:DeleteMessage, sqs:GetQueueAttributes]
                Resource: !GetAtt AppQueue.Arn
{{- end}}
{{- if .Wants.S3}}
              - Effect: Allow
                Action: [s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket]
                Resource: [!GetAtt AppBucket.Arn, !Sub "${AppBucket.Arn}/*"]
{{- end}}
{{- end}}

  TaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub "kagerou-${EnvKagerouEnv}"
      Cpu: "256"
      Memory: "512"
      NetworkMode: awsvpc
      RequiresCompatibilities: [FARGATE]
      ExecutionRoleArn: !GetAtt ExecutionRole.Arn
{{- if or .Wants.DynamoDB .Wants.SNS .Wants.SQS .Wants.S3}}
      TaskRoleArn: !GetAtt TaskRole.Arn
{{- end}}
      ContainerDefinitions:
        - Name: app
          Image: !Ref EnvImageUri
          PortMappings:
            - ContainerPort: {{if .Port}}{{.Port}}{{else}}8080{{end}}
          Environment:
            - { Name: PORT, Value: "{{if .Port}}{{.Port}}{{else}}8080{{end}}" }
            - { Name: KAGEROU_ENV, Value: !Ref EnvKagerouEnv }
            - { Name: KAGEROU_URL, Value: !Ref EnvKagerouUrl }
{{- if .Wants.DynamoDB}}
            - { Name: TABLE_NAME, Value: !Ref AppTable }
{{- end}}
{{- if .Wants.SNS}}
            - { Name: TOPIC_ARN, Value: !Ref AppTopic }
{{- end}}
{{- if .Wants.SQS}}
            - { Name: QUEUE_URL, Value: !Ref AppQueue }
{{- end}}
{{- if .Wants.S3}}
            - { Name: BUCKET_NAME, Value: !Ref AppBucket }
{{- end}}
{{- if .Wants.Redis}}
            - { Name: REDIS_URL, Value: !Ref EnvRedisUrl }
{{- end}}
{{- if .Wants.OpenSearch}}
            - { Name: OPENSEARCH_URL, Value: !Ref EnvOpensearchUrl }
{{- end}}
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: !Ref LogGroup
              awslogs-region: !Ref AWS::Region
              awslogs-stream-prefix: app

  # タスクの IP は起動のたびに変わるので Cloud Map に登録し、HTTP API は
  # サービス名で引く(ALB 構成のターゲットグループに当たる役)。
  DiscoveryService:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: !Ref EnvKagerouEnv
      NamespaceId: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_namespace_id{{"}}"}}"
      DnsConfig:
        DnsRecords:
          # VPC Link 統合は **SRV を要求する**(A レコードでは繋がらない)。
          # ポートは ECS が ServiceRegistries から埋める
          - Type: SRV
            TTL: 10
        RoutingPolicy: MULTIVALUE
      # 環境は消えるので、登録解除を待たせない
      HealthCheckCustomConfig:
        FailureThreshold: 1

  Service:
    Type: AWS::ECS::Service
    Properties:
      Cluster: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_cluster{{"}}"}}"
      TaskDefinition: !Ref TaskDefinition
      DesiredCount: 1
      LaunchType: FARGATE
      NetworkConfiguration:
        AwsvpcConfiguration:
          AssignPublicIp: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_assign_public_ip{{"}}"}}"
          Subnets: !Ref BaseSubnets
          SecurityGroups: ["{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_task_security_group{{"}}"}}"]
      ServiceRegistries:
        # SRV レコードにはコンテナとポートが要る(ここが無いと登録できない)
        - RegistryArn: !GetAtt DiscoveryService.Arn
          ContainerName: app
          ContainerPort: {{if .Port}}{{.Port}}{{else}}8080{{end}}

  # 入口。環境ごとに 1 本持つが、HTTP API 自体に固定費は無い
  HttpApi:
    Type: AWS::ApiGatewayV2::Api
    Properties:
      Name: !Sub "kagerou-${EnvKagerouEnv}"
      ProtocolType: HTTP

  Integration:
    Type: AWS::ApiGatewayV2::Integration
    Properties:
      ApiId: !Ref HttpApi
      IntegrationType: HTTP_PROXY
      IntegrationMethod: ANY
      ConnectionType: VPC_LINK
      ConnectionId: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_vpc_link_id{{"}}"}}"
      IntegrationUri: !GetAtt DiscoveryService.Arn
      PayloadFormatVersion: "1.0"

  DefaultRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref HttpApi
      RouteKey: $default
      Target: !Sub "integrations/${Integration}"

  Stage:
    Type: AWS::ApiGatewayV2::Stage
    Properties:
      ApiId: !Ref HttpApi
      StageName: $default
      AutoDeploy: true

  # url_template で先に決めた URL をそのまま使う(CONTRACT §5: 環境の URL は
  # 作成前に確定する)。証明書とゾーンは共有ベースの持ち物。
  DomainName:
    Type: AWS::ApiGatewayV2::DomainName
    Properties:
      # https://pr-42.api.example.com → pr-42.api.example.com
      DomainName: !Select [1, !Split ["//", !Ref EnvKagerouUrl]]
      DomainNameConfigurations:
        - CertificateArn: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_certificate_arn{{"}}"}}"
          EndpointType: REGIONAL

  ApiMapping:
    Type: AWS::ApiGatewayV2::ApiMapping
    DependsOn: Stage
    Properties:
      ApiId: !Ref HttpApi
      DomainName: !Ref DomainName
      Stage: $default

  DnsRecord:
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/apigw_hosted_zone_id{{"}}"}}"
      Name: !Select [1, !Split ["//", !Ref EnvKagerouUrl]]
      Type: A
      AliasTarget:
        DNSName: !GetAtt DomainName.RegionalDomainName
        HostedZoneId: !GetAtt DomainName.RegionalHostedZoneId
{{- if .Wants.DynamoDB}}

  # 依存に DynamoDB クライアントを検出したので同梱(on-demand = アイドル $0)
  AppTable:
    Type: AWS::DynamoDB::Table
    Properties:
      BillingMode: PAY_PER_REQUEST
      AttributeDefinitions:
        - AttributeName: id # TODO: match your real key schema
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
{{- end}}
{{- if .Wants.SNS}}

  # 依存に SNS クライアントを検出したので同梱(アイドル $0)
  AppTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: !Sub "{{.Project}}-${EnvKagerouEnv}-events"
{{- end}}
{{- if .Wants.SQS}}

  # 依存に SQS クライアントを検出したので同梱(アイドル $0)
  AppQueue:
    Type: AWS::SQS::Queue
{{- end}}
{{- if and .Wants.SNS .Wants.SQS}}

  # SNS と SQS の両方を使うので、Topic → Queue の配線も同梱(fan-out の定型)
  AppQueueSubscription:
    Type: AWS::SNS::Subscription
    Properties:
      Protocol: sqs
      TopicArn: !Ref AppTopic
      Endpoint: !GetAtt AppQueue.Arn
  AppQueuePolicy:
    Type: AWS::SQS::QueuePolicy
    Properties:
      Queues: [!Ref AppQueue]
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: sns.amazonaws.com }
            Action: sqs:SendMessage
            Resource: !GetAtt AppQueue.Arn
            Condition:
              ArnEquals: { "aws:SourceArn": !Ref AppTopic }
{{- end}}
{{- if .Wants.S3}}

  # 依存に S3 クライアントを検出したので、アプリデータ用バケットを同梱
  AppBucket:
    Type: AWS::S3::Bucket
{{- end}}

Outputs:
  KagerouUrl:
    Value: !Ref EnvKagerouUrl
  ApiId:
    Value: !Ref HttpApi
  ServiceName:
    Value: !GetAtt Service.Name
