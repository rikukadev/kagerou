# kagerou configuration (https://github.com/rikukadev/kagerou)
project: {{.Project}}
{{- if .Static}}
driver: static # no compute; the built site is synced under the preview base
{{- else if .ECS}}
driver: stack
# compute: ecs — sam は使わない。CI が docker push したイメージ URI を
# --env IMAGE_URI で渡す(workflow が生成済み)。テンプレートは素の CFN
template: template.yaml
{{- else}}
driver: stack
template: packaged.yaml # output of `sam build && sam package` (building is CI's job)
{{- end}}
region: {{.Region}}
{{- if not .Static}}
name_prefix: {{.Project}}- # stack name becomes {{.Project}}-pr-42
{{- end}}
{{- if .ECS}}
ttl: 24h # Fargate は動いている間ずっと課金されるので短め(Lambda 形は 72h)
readiness_path: /healthz # Fargate の起動は 1〜2 分。応答するまで ready にしない
readiness_timeout: 300s
{{- else}}
ttl: 72h
{{- end}}
{{- if and .ALB .Domain}}
# URL は共有 ALB(deploy/alb-base.yaml)経由の独自ドメイン。ホスト名は
# この url_template から導かれる(テンプレートの EnvKagerouUrl 参照)
url_template: "https://{name}.{{.Domain}}"
{{- else if .ECS}}
# compute: ecs は共有 ALB のホスト名ルーティングに url_template が必須。
# deploy/alb-base.yaml を作ったドメインに合わせること
url_template: "" # TODO: https://{name}.<your alb-base domain>
{{- else if .Domain}}
url_template: "https://{name}.{{.Domain}}" # preview base(共有 CloudFront)経由
{{- else if .Static}}
# driver: static は compute が無く URL を出力できないので url_template が必須。
# preview base を作ると <name>.<その domain> になる。
url_template: "" # TODO: https://{name}.<your preview domain>
{{- end}}
{{- if .Static}}

static:
  dist: {{.Dist}} # built output to sync
  bucket: {{if .BaseBucket}}{{.BaseBucket}}{{else}}"" # TODO: preview base bucket (kagerou init detects it once the base exists){{end}}
{{- if eq .Routing "spa"}}
  # クライアントルーターを検出。拡張子の無いパスは全て index.html に写す。
  # directory のままだと /about の実体が無く 403 になる(kagerou#86)。
  #
  # **この値は preview base を作るときに焼き込まれる。** 後から変えるなら
  # ベースを deploy し直すこと(deploy/preview-base.yaml)。
  routing: spa
{{- end}}
{{- end}}
{{- if and (eq .URLShape "cross") (not .Static)}}

# クロスオリジン構成を検出。相手アプリ(別 kagerou プロジェクト)と環境名で
# 連動するなら peer を宣言する — up のたびに相手の同名 env を探し、居なければ
# fallback の env に繋ぐ。解決結果はテンプレートが EnvPeerEnv / EnvPeerUrl を
# 宣言していれば届く(docs/CONTRACT.md §10)。
#peer:
#  project: <相手の project 名>
#  fallback: main
{{- end}}
{{- if not .Static}}
env:
  # {name} expands to the environment name. Values are delivered to the
  # Env<Key> template parameters (see docs/CONTRACT.md)
  KAGEROU_ENV: "{name}"
{{- end}}
{{- if .ECS}}
  # IMAGE_URI と RULE_PRIORITY は実行ごとに変わるので CI が --env で渡す
  # (workflow 生成済み)。手元から up するときは自分で渡す:
  #   kagerou up --name e2e-1 --env IMAGE_URI=<ecr>:e2e-1 --env RULE_PRIORITY=900
{{- else if .LambdaALB}}
  # RULE_PRIORITY は共有リスナー上で一意にする値。CI が PR 番号を --env で渡す
  # (workflow 生成済み)。手元から up するときは空いている番号を自分で渡す:
  #   kagerou up --name e2e-1 --env RULE_PRIORITY=900
{{- end}}
{{- if .Wants.Redis}}
  # redis を検出。ElastiCache は preview 向きでない(常時課金・VPC・作成に数分)ため
  # per-env には作らない。共有ベースに 1 台置き、キーを "{name}:" で prefix して分離する
  REDIS_URL: "" # TODO: shared redis endpoint (key prefix "{name}:")
{{- end}}
{{- if .Wants.OpenSearch}}
  # opensearch を検出。ドメインは重いので per-env には作らない。共有ドメインに
  # インデックス "{name}-*" で分離する
  OPENSEARCH_URL: "" # TODO: shared opensearch endpoint (index prefix "{name}-")
{{- end}}
{{- if .Sashiki}}
  DB_HOST: sashiki.internal # TODO: host of your sashiki proxy
  DB_PORT: "3306"
  DB_USER: dev@{name}
  DB_PASSWORD: dev # TODO: app password of your baseline
  DB_NAME: app     # TODO: database name
hooks:
  # pre_up は up のたびに走るので冪等でなければならない。--exist-ok を付けないと
  # 2 回目が 409 で落ち、`|| true` で **本物のエラーまで握り潰す** ことになる。
  # sashiki v0.10.0 以降で使える(それ以前は `|| true` が要る)。
  pre_up: sashiki create {name} --exist-ok
  post_down: sashiki delete {name}
{{- end}}
