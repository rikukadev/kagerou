# Preview environment per pull request (kagerou).
{{- if .Static}}
# Required repository variables: AWS_ROLE_ARN / AWS_REGION
# driver: static — build the site, kagerou syncs it under the preview base.
# No container, no ECR, no SAM.
{{- else}}
# Required repository variables: AWS_ROLE_ARN / AWS_REGION / ECR_REPOSITORY
{{- end}}
name: pr-preview

on:
  pull_request:
    types: [opened, reopened, synchronize, closed]

permissions:
  id-token: write
  contents: read
  pull-requests: write

concurrency:
  group: preview-${{"{{"}} github.event.pull_request.number {{"}}"}}
  cancel-in-progress: false

jobs:
  preview:
    if: github.event.action != 'closed' && github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{"{{"}} vars.AWS_ROLE_ARN {{"}}"}}
          aws-region: ${{"{{"}} vars.AWS_REGION {{"}}"}}
{{- if .Static}}
      - uses: actions/setup-node@v6
        with:
          node-version: 22
          cache: npm
      - name: Build
        run: |
          npm ci
          npm run build
{{- else if .ECS}}
      # compute: ecs — sam は使わない。イメージを push して URI を kagerou に渡す
      - name: Build and push image
        run: |
          aws ecr get-login-password | docker login --username AWS \
            --password-stdin "${ECR_REPOSITORY%%/*}"
          docker build -t "$ECR_REPOSITORY:pr-$PR" .
          docker push "$ECR_REPOSITORY:pr-$PR"
        env:
          ECR_REPOSITORY: ${{"{{"}} vars.ECR_REPOSITORY {{"}}"}}
          PR: ${{"{{"}} github.event.pull_request.number {{"}}"}}
{{- else}}
      - uses: aws-actions/setup-sam@v2
        with:
          use-installer: true
      - name: Build and package
        run: |
          sam build
          sam package \
            --image-repository "${{"{{"}} vars.ECR_REPOSITORY {{"}}"}}" \
            --output-template-file packaged.yaml
{{- end}}
      - uses: rikukadev/kagerou/action@v0
        with:
          name: pr-${{"{{"}} github.event.pull_request.number {{"}}"}}
{{- if .ECS}}
          env: |
            IMAGE_URI=${{"{{"}} vars.ECR_REPOSITORY {{"}}"}}:pr-${{"{{"}} github.event.pull_request.number {{"}}"}}
{{- if .ALB}}
            RULE_PRIORITY=${{"{{"}} github.event.pull_request.number {{"}}"}}
{{- end}}
{{- else if .LambdaALB}}
          # 共有リスナー上で一意な優先度(PR 番号をそのまま使う)
          env: |
            RULE_PRIORITY=${{"{{"}} github.event.pull_request.number {{"}}"}}
{{- end}}

  cleanup:
    if: github.event.action == 'closed' && github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{"{{"}} vars.AWS_ROLE_ARN {{"}}"}}
          aws-region: ${{"{{"}} vars.AWS_REGION {{"}}"}}
      - uses: rikukadev/kagerou/action@v0
        with:
          name: pr-${{"{{"}} github.event.pull_request.number {{"}}"}}
          down: "true"
