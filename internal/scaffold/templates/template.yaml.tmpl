AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: >
  Preview environment for {{.Project}} (generated by kagerou init).
  Wraps the app with Lambda Web Adapter so one stack = one environment.

# Values for the app (kagerou --env / env in kagerou.yaml) arrive as Env<Key>
# parameters. Example: --env DB_HOST=... -> EnvDbHost. Undeclared keys are
# rejected (see docs/CONTRACT.md).
Parameters:
  EnvKagerouEnv:
    Type: String
    Description: Environment name. Injected via `KAGEROU_ENV: "{name}"` in kagerou.yaml

Globals:
  Function:
    Timeout: 30
    MemorySize: 512

Resources:
  AppFunction:
    Type: AWS::Serverless::Function
    Metadata:
      DockerContext: .
{{- if .HasDockerfile}}
      Dockerfile: Dockerfile # 既存の Dockerfile(LWA 拡張入り)をそのまま使う
{{- else}}
      Dockerfile: Dockerfile # TODO: run your app as an HTTP server wrapped by LWA
{{- end}}
      DockerTag: !Ref EnvKagerouEnv
    Properties:
      PackageType: Image
      Environment:
        Variables:
{{- if .Port}}
          AWS_LWA_PORT: "{{.Port}}" # detected from your Dockerfile/compose
{{- else}}
          AWS_LWA_PORT: "3000" # TODO: match your app's listen port
{{- end}}
          # Implement /healthz to avoid 502s before the server is ready
          AWS_LWA_READINESS_CHECK_PATH: /healthz
          KAGEROU_ENV: !Ref EnvKagerouEnv
      Events:
        Http:
          Type: HttpApi
          Properties:
            ApiId: !Ref HttpApi

  HttpApi:
    Type: AWS::Serverless::HttpApi
    Properties:
      StageName: $default

Outputs:
  # kagerou picks this output up as the environment URL (CONTRACT §5)
  KagerouUrl:
    Value: !Sub "https://${HttpApi}.execute-api.${AWS::Region}.amazonaws.com"
