AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: >
  Preview environment for {{.Project}} (generated by kagerou init).
  Wraps the app with Lambda Web Adapter so one stack = one environment.

# Values for the app (kagerou --env / env in kagerou.yaml) arrive as Env<Key>
# parameters. Example: --env DB_HOST=... -> EnvDbHost. Undeclared keys are
# rejected (see docs/CONTRACT.md).
Parameters:
  EnvKagerouEnv:
    Type: String
    Description: 'Environment name. Injected via `KAGEROU_ENV: "{name}"` in kagerou.yaml'
{{- if .LambdaALB}}
  # 共有 ALB 入口(独自ドメイン)。ホスト名は url_template から導かれた URL を使う
  EnvKagerouUrl:
    Type: String
    Description: Environment URL (from url_template). The ALB host header is derived from it
  EnvRulePriority:
    Type: Number
    Description: >
      Listener-rule priority; must be unique on the shared listener. CI passes
      the PR number (--env RULE_PRIORITY). For manual up, pick a free number.
{{- end}}
{{- if .Wants.Redis}}
  EnvRedisUrl:
    Type: String
    Default: ""
    Description: Shared redis endpoint (set via env REDIS_URL in kagerou.yaml)
{{- end}}
{{- if .Wants.OpenSearch}}
  EnvOpensearchUrl:
    Type: String
    Default: ""
    Description: Shared opensearch endpoint (set via env OPENSEARCH_URL in kagerou.yaml)
{{- end}}

Globals:
  Function:
    Timeout: 30
    MemorySize: 512

Resources:
  AppFunction:
    Type: AWS::Serverless::Function
    Metadata:
      DockerContext: .
{{- if .HasDockerfile}}
      Dockerfile: Dockerfile # 既存の Dockerfile(LWA 拡張入り)をそのまま使う
{{- else}}
      Dockerfile: Dockerfile # TODO: run your app as an HTTP server wrapped by LWA
{{- end}}
      DockerTag: !Ref EnvKagerouEnv
    Properties:
      PackageType: Image
      Environment:
        Variables:
{{- if .Port}}
          AWS_LWA_PORT: "{{.Port}}" # matches your Dockerfile (detected or scaffolded)
{{- else}}
          AWS_LWA_PORT: "3000" # TODO: match your app's listen port
{{- end}}
          # Implement /healthz to avoid 502s before the server is ready
          AWS_LWA_READINESS_CHECK_PATH: /healthz
          KAGEROU_ENV: !Ref EnvKagerouEnv
{{- if .Wants.DynamoDB}}
          TABLE_NAME: !Ref AppTable
{{- end}}
{{- if .Wants.SNS}}
          TOPIC_ARN: !Ref AppTopic
{{- end}}
{{- if .Wants.SQS}}
          QUEUE_URL: !Ref AppQueue
{{- end}}
{{- if .Wants.S3}}
          BUCKET_NAME: !Ref AppBucket
{{- end}}
{{- if .Wants.Redis}}
          REDIS_URL: !Ref EnvRedisUrl
{{- end}}
{{- if .Wants.OpenSearch}}
          OPENSEARCH_URL: !Ref EnvOpensearchUrl
{{- end}}
{{- if or .Wants.DynamoDB .Wants.SNS .Wants.SQS .Wants.S3}}
      Policies:
{{- if .Wants.DynamoDB}}
        - DynamoDBCrudPolicy:
            TableName: !Ref AppTable
{{- end}}
{{- if .Wants.SNS}}
        - SNSPublishMessagePolicy:
            TopicName: !GetAtt AppTopic.TopicName
{{- end}}
{{- if .Wants.SQS}}
        - SQSSendMessagePolicy:
            QueueName: !GetAtt AppQueue.QueueName
{{- end}}
{{- if .Wants.S3}}
        - S3CrudPolicy:
            BucketName: !Ref AppBucket
{{- end}}
{{- end}}
{{- if not .LambdaALB}}
      Events:
        Http:
          Type: HttpApi
          Properties:
            ApiId: !Ref HttpApi

  HttpApi:
    Type: AWS::Serverless::HttpApi
    Properties:
      StageName: $default
{{- else}}

  # --- 入口: 共有 ALB(独自ドメイン)---------------------------------------
  # API Gateway は作らない。ALB のリスナールールが自分のホスト名だけを横取りし、
  # Lambda ターゲットに転送する。ALB 本体(固定費)は共有ベースの持ち物で、
  # 環境が足すのはルールとターゲットグループだけ(どちらも無料)。
  # Lambda は VPC の外のままなので、アイドル $0 は変わらない。
  AlbInvokePermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref AppFunction
      Action: lambda:InvokeFunction
      Principal: elasticloadbalancing.amazonaws.com

  AlbTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    # 権限より先に登録すると ALB が invoke できず登録に失敗する
    DependsOn: AlbInvokePermission
    Properties:
      TargetType: lambda
      Targets:
        - Id: !GetAtt AppFunction.Arn
      # Lambda ターゲットのヘルスチェックは任意。プレビューでは無効にして
      # 起動直後の空振りを避ける(準備できたかは kagerou の readiness_path で見る)
      HealthCheckEnabled: false

  AlbListenerRule:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn: "{{"{{"}}resolve:ssm:/kagerou/base/{{.Project}}/alb_listener_arn{{"}}"}}"
      Priority: !Ref EnvRulePriority
      Conditions:
        - Field: host-header
          # https://pr-42.myapp.example.com → pr-42.myapp.example.com
          Values: [!Select [1, !Split ["//", !Ref EnvKagerouUrl]]]
      Actions:
        - Type: forward
          TargetGroupArn: !Ref AlbTargetGroup
{{- end}}
{{- if .Wants.DynamoDB}}

  # 依存に DynamoDB クライアントを検出したので同梱(on-demand = アイドル $0)
  AppTable:
    Type: AWS::DynamoDB::Table
    Properties:
      BillingMode: PAY_PER_REQUEST
      AttributeDefinitions:
        - AttributeName: id # TODO: match your real key schema
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
{{- end}}
{{- if .Wants.SNS}}

  # 依存に SNS クライアントを検出したので同梱(アイドル $0)。他アプリの環境と
  # 連動させる場合は、Topic 名を環境名から導ける形にしておくと発見しやすい
  AppTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: !Sub "{{.Project}}-${EnvKagerouEnv}-events"
{{- end}}
{{- if .Wants.SQS}}

  # 依存に SQS クライアントを検出したので同梱(アイドル $0)
  AppQueue:
    Type: AWS::SQS::Queue
{{- end}}
{{- if and .Wants.SNS .Wants.SQS}}

  # SNS と SQS の両方を使うので、Topic → Queue の配線も同梱(fan-out の定型)
  AppQueueSubscription:
    Type: AWS::SNS::Subscription
    Properties:
      Protocol: sqs
      TopicArn: !Ref AppTopic
      Endpoint: !GetAtt AppQueue.Arn
  AppQueuePolicy:
    Type: AWS::SQS::QueuePolicy
    Properties:
      Queues: [!Ref AppQueue]
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: sns.amazonaws.com }
            Action: sqs:SendMessage
            Resource: !GetAtt AppQueue.Arn
            Condition:
              ArnEquals: { "aws:SourceArn": !Ref AppTopic }
{{- end}}
{{- if .Wants.S3}}

  # 依存に S3 クライアントを検出したので、アプリデータ用バケットを同梱
  AppBucket:
    Type: AWS::S3::Bucket
{{- end}}

Outputs:
  # kagerou picks this output up as the environment URL (CONTRACT §5)
  KagerouUrl:
{{- if .LambdaALB}}
    Value: !Ref EnvKagerouUrl
{{- else}}
    Value: !Sub "https://${HttpApi}.execute-api.${AWS::Region}.amazonaws.com"
{{- end}}
