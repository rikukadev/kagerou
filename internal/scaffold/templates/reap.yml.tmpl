# TTL 切れ環境の回収(最後の網)。close イベントの取りこぼしもここで消える。
name: kagerou-reap

on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch: {}

permissions:
  id-token: write
  contents: read

jobs:
  reap:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{"{{"}} vars.AWS_ROLE_ARN {{"}}"}}
          aws-region: ${{"{{"}} vars.AWS_REGION {{"}}"}}
      - uses: rikukadev/kagerou/action@main
        with:
          reap: "true"
          grace: 1h
