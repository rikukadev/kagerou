{{generatedBy "#"}}
# Reap expired environments (the last safety net). Environments whose
# close event was lost are also collected here.
name: kagerou-reap

on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch: {}

permissions:
  id-token: write
  contents: read

jobs:
  reap:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: ${{"{{"}} vars.AWS_ROLE_ARN {{"}}"}}
          aws-region: ${{"{{"}} vars.AWS_REGION {{"}}"}}
      - uses: rikukadev/kagerou/action@v0
        with:
          reap: "true"
          grace: 1h
