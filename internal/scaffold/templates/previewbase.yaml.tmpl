AWSTemplateFormatVersion: "2010-09-09"
Description: >
  kagerou preview base — shared delivery for one app's preview environments.
  Deploy ONCE per app (project), in us-east-1 (CloudFront certificates must
  live there). Environments become https://<name>.<DomainName>/ backed by
  s3://<bucket>/<name>/. This file lives in the app repository on purpose:
  anyone on the repo can update the base by re-running the deploy (idempotent).

Parameters:
  Project:
    Type: String
    AllowedPattern: "[a-z]([a-z0-9-]*[a-z0-9])?"
    Description: kagerou project name; namespaces every resource so each app owns its base
  Mode:
    Type: String
    Default: per-app
    AllowedValues: [per-app, shared]
    Description: >
      per-app: one base per project; URLs are <name>.<DomainName>.
      shared: one base for every project on this domain; URLs are
      <project>--<name>.<DomainName> (a wildcard certificate only covers one
      label, so the project has to live in the same label as the name).
  DomainName:
    Type: String
    Description: >
      per-app: this app's preview domain (todo.example.com -> pr-42.todo.example.com).
      shared: the shared domain (example.com -> todo--pr-42.example.com).
  HostedZoneId:
    Type: AWS::Route53::HostedZone::Id
    Description: Hosted zone that owns the parent of DomainName
  Routing:
    Type: String
    Default: directory
    AllowedValues: [directory, spa]
    Description: >
      How to resolve extensionless paths. "directory" appends /index.html
      (static site generators emit /about/index.html). "spa" maps them all to
      the environment's index.html and lets the client router take over — the
      file for /about does not exist, so "directory" would 403.

Conditions:
  IsShared: !Equals [!Ref Mode, shared]

Resources:
  Bucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub "kagerou-base-${Project}-${AWS::AccountId}"
      # shared モードでは Project=shared を渡す(バケットは 1 つ、中は
      # <project>/<name>/… で分かれる)
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  Certificate:
    Type: AWS::CertificateManager::Certificate
    Properties:
      DomainName: !Sub "*.${DomainName}"
      ValidationMethod: DNS
      DomainValidationOptions:
        - DomainName: !Sub "*.${DomainName}"
          HostedZoneId: !Ref HostedZoneId

  OriginAccessControl:
    Type: AWS::CloudFront::OriginAccessControl
    Properties:
      OriginAccessControlConfig:
        Name: !Sub "kagerou-base-${Project}"
        OriginAccessControlOriginType: s3
        SigningBehavior: always
        SigningProtocol: sigv4

  # Host の最初のラベル(pr-42.preview.example.com → pr-42)を S3 プレフィックスに写す。
  # 拡張子の無いパスは index.html に落とす(SPA のルーティング想定)
  HostToPrefixFunction:
    Type: AWS::CloudFront::Function
    Properties:
      Name: !Sub "kagerou-base-${Project}-host-to-prefix"
      AutoPublish: true
      FunctionConfig:
        Comment: map <name>.<domain>/<uri> to /<name>/<uri>
        Runtime: cloudfront-js-2.0
      # Mode と Routing を定数として焼き込み、**本体は 1 つ**にする。
      # !If で分けると Mode × Routing で 4 本になり、どれが配信されているのか
      # テンプレートから読み取れなくなる。
      FunctionCode: !Sub |
        var MODE = '${Mode}';
        var ROUTING = '${Routing}';

        function handler(event) {
          var req = event.request;
          var label = req.headers.host.value.split('.')[0];
          // shared:  <project>--<name>.<domain> -> /<project>/<name>/…
          // per-app: <name>.<domain>            -> /<name>/…
          var prefix = label;
          if (MODE === 'shared') {
            var sep = label.indexOf('--');
            if (sep >= 0) {
              prefix = label.slice(0, sep) + '/' + label.slice(sep + 2);
            }
          }
          var uri = req.uri;
          if (uri.endsWith('/')) {
            uri += 'index.html';
          } else if (!uri.split('/').pop().includes('.')) {
            // 拡張子の無いパス。SSG は /about/index.html を出すが、SPA では
            // その実体が無く、OAC 経由の S3 は 404 ではなく 403 を返す。
            //
            // CloudFront のカスタムエラーページでは代替できない。指せるのは
            // 固定パス 1 つで、環境ごと(プレフィックス配下)には切り替わらない。
            uri = ROUTING === 'spa' ? '/index.html' : uri + '/index.html';
          }
          req.uri = '/' + prefix + uri;
          return req;
        }
  Distribution:
    Type: AWS::CloudFront::Distribution
    Properties:
      DistributionConfig:
        Enabled: true
        Comment: !Sub "kagerou preview base (${Project})"
        HttpVersion: http2
        Aliases:
          - !Sub "*.${DomainName}"
        ViewerCertificate:
          AcmCertificateArn: !Ref Certificate
          SslSupportMethod: sni-only
          MinimumProtocolVersion: TLSv1.2_2021
        DefaultCacheBehavior:
          TargetOriginId: bucket
          ViewerProtocolPolicy: redirect-to-https
          # プレビューは正しさ優先: キャッシュ無効(Managed-CachingDisabled)にして
          # 環境更新のたびの invalidation を不要にする
          CachePolicyId: 4135ea2d-6df8-44a3-9df3-4b5a84be39ad
          FunctionAssociations:
            - EventType: viewer-request
              FunctionARN: !GetAtt HostToPrefixFunction.FunctionMetadata.FunctionARN
        Origins:
          - Id: bucket
            DomainName: !GetAtt Bucket.RegionalDomainName
            OriginAccessControlId: !GetAtt OriginAccessControl.Id
            S3OriginConfig:
              OriginAccessIdentity: ""

  BucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref Bucket
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: cloudfront.amazonaws.com
            Action: s3:GetObject
            Resource: !Sub "${Bucket.Arn}/*"
            Condition:
              StringEquals:
                AWS:SourceArn: !Sub "arn:aws:cloudfront::${AWS::AccountId}:distribution/${Distribution}"

  WildcardRecord:
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref HostedZoneId
      Name: !Sub "*.${DomainName}"
      Type: A
      AliasTarget:
        DNSName: !GetAtt Distribution.DomainName
        HostedZoneId: Z2FDTNDATAQYW2 # CloudFront の固定 hosted zone

  # ベース↔環境のデータ契約(CONTRACT §9)。kagerou init はこの SSM キーで
  # 既存ベースを検出する。ベースを CFN 以外(Terraform 等)で作る場合も、
  # 同じキーを書けば kagerou からは同じに見える(ツール非依存)。
  DomainParam:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !If [IsShared, "/kagerou/base/_shared/domain", !Sub "/kagerou/base/${Project}/domain"]
      Type: String
      Value: !Ref DomainName
  BucketParam:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !If [IsShared, "/kagerou/base/_shared/bucket", !Sub "/kagerou/base/${Project}/bucket"]
      Type: String
      Value: !Ref Bucket
  DistributionParam:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !If [IsShared, "/kagerou/base/_shared/distribution", !Sub "/kagerou/base/${Project}/distribution"]
      Type: String
      Value: !Ref Distribution
  # ベースがどちらのモードで配るかは、あとから見て分かる必要がある
  # (ディープリンクが 403 になったとき、まずここを見れば切り分けられる)。
  RoutingParam:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !If [IsShared, "/kagerou/base/_shared/routing", !Sub "/kagerou/base/${Project}/routing"]
      Type: String
      Value: !Ref Routing

Outputs:
  Domain:
    Value: !Ref DomainName
    Export:
      Name: !Sub "kagerou-preview-base:${Project}:domain"
  Bucket:
    Value: !Ref Bucket
    Export:
      Name: !Sub "kagerou-preview-base:${Project}:bucket"
  DistributionId:
    Value: !Ref Distribution
    Export:
      Name: !Sub "kagerou-preview-base:${Project}:distribution"
