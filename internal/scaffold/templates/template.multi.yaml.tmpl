AWSTemplateFormatVersion: "2010-09-09"
Transform: AWS::Serverless-2016-10-31
Description: >
  Preview environment for {{.Project}} (generated by kagerou init).
  {{len .Services}} services in one environment, split by HOST behind the shared ALB
  (DESIGN §13: host-based, not path-based — the app's URL structure stays put).

# アプリに届けたい値は Env<Key>(CONTRACT §4)。共有 ALB の値はベースが書いた
# SSM({{"{{"}}resolve:ssm:/kagerou/base/{{$.Project}}/alb_*{{"}}"}})を動的参照で読む。
Parameters:
  EnvKagerouEnv:
    Type: String
    Description: 'Environment name. Injected via `KAGEROU_ENV: "{name}"` in kagerou.yaml'
  EnvKagerouUrl:
    Type: String
    Description: Environment URL (from url_template) — points at the primary service
  EnvRulePriority:
    Type: Number
    Description: >
      Base priority on the shared listener. Each service appends its index
      (e.g. base 42 -> 420, 421, ...), so one PR never collides with another.
      CI passes the PR number (--env RULE_PRIORITY).
{{- if .Wants.Redis}}
  EnvRedisUrl:
    Type: String
    Default: ""
    Description: Shared redis endpoint (set via env REDIS_URL in kagerou.yaml)
{{- end}}
{{- if .Wants.OpenSearch}}
  EnvOpensearchUrl:
    Type: String
    Default: ""
    Description: Shared opensearch endpoint (set via env OPENSEARCH_URL in kagerou.yaml)
{{- end}}

Globals:
  Function:
    Timeout: {{.TimeoutOrDefault}}
    MemorySize: {{.MemoryOrDefault}}

Resources:
{{- range .ServiceSpecs}}

  # --- {{.Name}}{{if .Primary}}(代表: url_template が指す先){{end}} ------------
  # 同じイメージを command で使い分ける(push は 1 回で済む)
  {{.Logical}}Function:
    Type: AWS::Serverless::Function
    Metadata:
      # range の中なので $ でルートを見る(. は ServiceSpec)。
      # サービスごとに Dockerfile を分ける構成はまだ扱っていない(#160)
      DockerContext: {{$.DockerContext}}
      Dockerfile: {{$.DockerfileOrDefault}}
      DockerTag: !Ref EnvKagerouEnv
    Properties:
      PackageType: Image
      ImageConfig:
        Command: ["/{{.Name}}"] # TODO: match the entrypoint of this service in your image
      Environment:
        Variables:
          AWS_LWA_PORT: "{{$.PortOrDefault}}"
          # 検出できたアプリのパス。無ければ従来どおり /healthz(#182)
          AWS_LWA_READINESS_CHECK_PATH: {{if $.HealthPath}}{{$.HealthPath}}{{else}}/healthz{{end}}
          KAGEROU_ENV: !Ref EnvKagerouEnv
          KAGEROU_URL: !Ref EnvKagerouUrl
{{- range $.ServiceSpecs}}
          # 同じ環境の他サービスはホスト名から決まる(発見のための設定は要らない)
          {{.EnvKey}}: !Sub "https://{{.Host}}"
{{- end}}
{{- if $.Wants.DynamoDB}}
          TABLE_NAME: !Ref AppTable
{{- end}}
{{- if $.Wants.SNS}}
          TOPIC_ARN: !Ref AppTopic
{{- end}}
{{- if $.Wants.SQS}}
          QUEUE_URL: !Ref AppQueue
{{- end}}
{{- if $.Wants.S3}}
          BUCKET_NAME: !Ref AppBucket
{{- end}}
{{- if $.Wants.Redis}}
          REDIS_URL: !Ref EnvRedisUrl
{{- end}}
{{- if $.Wants.OpenSearch}}
          OPENSEARCH_URL: !Ref EnvOpensearchUrl
{{- end}}
{{- if or $.Wants.DynamoDB $.Wants.SNS $.Wants.SQS $.Wants.S3}}
      Policies:
{{- if $.Wants.DynamoDB}}
        - DynamoDBCrudPolicy:
            TableName: !Ref AppTable
{{- end}}
{{- if $.Wants.SNS}}
        - SNSPublishMessagePolicy:
            TopicName: !GetAtt AppTopic.TopicName
{{- end}}
{{- if $.Wants.SQS}}
        - SQSSendMessagePolicy:
            QueueName: !GetAtt AppQueue.QueueName
{{- end}}
{{- if $.Wants.S3}}
        - S3CrudPolicy:
            BucketName: !Ref AppBucket
{{- end}}
{{- end}}

  {{.Logical}}AlbPermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref {{.Logical}}Function
      Action: lambda:InvokeFunction
      Principal: elasticloadbalancing.amazonaws.com

  {{.Logical}}TargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    DependsOn: {{.Logical}}AlbPermission
    Properties:
      TargetType: lambda
      Targets:
        - Id: !GetAtt {{.Logical}}Function.Arn
      HealthCheckEnabled: false

  {{.Logical}}ListenerRule:
    Type: AWS::ElasticLoadBalancingV2::ListenerRule
    Properties:
      ListenerArn: "{{"{{"}}resolve:ssm:/kagerou/base/{{$.Project}}/alb_listener_arn{{"}}"}}"
      # base 優先度 + サービスの枝番(CFN に算術が無いので文字列で連結する)
      Priority: !Sub "${EnvRulePriority}{{.Index}}"
      Conditions:
        - Field: host-header
          Values: [!Sub "{{.Host}}"]
      Actions:
        - Type: forward
          TargetGroupArn: !Ref {{.Logical}}TargetGroup
{{- end}}
{{- if .Wants.DynamoDB}}

  # 依存に DynamoDB クライアントを検出したので同梱(on-demand = アイドル $0)
  AppTable:
    Type: AWS::DynamoDB::Table
    Properties:
      BillingMode: PAY_PER_REQUEST
      AttributeDefinitions:
        - AttributeName: id # TODO: match your real key schema
          AttributeType: S
      KeySchema:
        - AttributeName: id
          KeyType: HASH
{{- end}}
{{- if .Wants.SNS}}

  # 依存に SNS クライアントを検出したので同梱(アイドル $0)
  AppTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: !Sub "{{.Project}}-${EnvKagerouEnv}-events"
{{- end}}
{{- if .Wants.SQS}}

  # 依存に SQS クライアントを検出したので同梱(アイドル $0)
  AppQueue:
    Type: AWS::SQS::Queue
{{- end}}
{{- if and .Wants.SNS .Wants.SQS}}

  # SNS と SQS の両方を使うので、Topic → Queue の配線も同梱(fan-out の定型)
  AppQueueSubscription:
    Type: AWS::SNS::Subscription
    Properties:
      Protocol: sqs
      TopicArn: !Ref AppTopic
      Endpoint: !GetAtt AppQueue.Arn
  AppQueuePolicy:
    Type: AWS::SQS::QueuePolicy
    Properties:
      Queues: [!Ref AppQueue]
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal: { Service: sns.amazonaws.com }
            Action: sqs:SendMessage
            Resource: !GetAtt AppQueue.Arn
            Condition:
              ArnEquals: { "aws:SourceArn": !Ref AppTopic }
{{- end}}
{{- if .Wants.S3}}

  # 依存に S3 クライアントを検出したので、アプリデータ用バケットを同梱
  AppBucket:
    Type: AWS::S3::Bucket
{{- end}}

Outputs:
  # kagerou はこれを環境の URL として拾う(CONTRACT §5)。代表サービスを指す
  KagerouUrl:
    Value: !Ref EnvKagerouUrl
{{- range .ServiceSpecs}}
  {{.Logical}}Url:
    Value: !Sub "https://{{.Host}}"
{{- end}}
