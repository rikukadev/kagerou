// kagerou edge auth — CloudFront の viewer-request で OIDC ログインを強制する。
// generated by `kagerou init --auth`
//
// なぜここでやるのか:
//   共有 CloudFront が配るのは S3 の静的成果物で、ALB の authenticate-oidc は
//   S3 を守れない。固定費ゼロのまま「全環境の前」で止められるのはここだけ。
//
// 設定の置き場:
//   Lambda@Edge は **環境変数を持てない**。client_secret をテンプレートに書くと
//   CloudFormation のコンソールから読めてしまうので、us-east-1 の SSM
//   (/kagerou/edge-auth/<domain>/*)から cold start 時に読む。どの SSM を読むかは
//   Host ヘッダの親ドメインから導くので、コードに焼き込む値はひとつも無い。
//
// callback を 1 か所に寄せている理由:
//   環境のホスト名は pr-42.<domain> のように毎回変わる。Google などの IdP は
//   redirect_uri をワイルドカードで登録できないので、受け口は auth.<domain> の
//   1 本だけにして、元のホストと URI は state に入れて持ち回る。
//   セッション Cookie は Domain=.<domain> で発行するので、全環境で共有される。
//
// 制約:
//   viewer-request の上限は 5 秒 / 128MB。cold start + discovery + token 交換が
//   ここに収まる必要がある(discovery とパラメータはコンテナ内で使い回す)。

import { createHmac, timingSafeEqual, randomBytes, createPublicKey, verify as verifySignature } from 'node:crypto'
import { SSMClient, GetParametersByPathCommand } from '@aws-sdk/client-ssm'

const COOKIE = 'kagerou_session'
const STATE_COOKIE = 'kagerou_oidc_state'
const CALLBACK_PATH = '/_kagerou/auth/callback'
const AUTH_LABEL = 'auth' // 受け口のホスト: auth.<domain>
const SESSION_TTL = 12 * 60 * 60 // 秒。プレビューの TTL より長くする意味は無い
const STATE_TTL = 10 * 60
const CLOCK_SKEW = 60
const MAX_TOKEN_AGE = 24 * 60 * 60
const JWKS_TTL = 60 * 60
const ALLOWED_ALGS = new Set(['RS256'])

// Lambda@Edge は us-east-1 で動く。設定もそこに置く(リージョンを跨がない)
const ssm = new SSMClient({ region: 'us-east-1' })
const configs = new Map() // domain -> Promise<config>

export const handler = async (event) => {
  const req = event.Records[0].cf.request
  const host = header(req, 'host')
  if (!host) return deny('no host header')

  const domain = host.slice(host.indexOf('.') + 1)
  let cfg
  try {
    cfg = await configFor(domain)
  } catch (err) {
    // 設定が無い状態で素通しすると、認証をかけたつもりの環境が全公開になる。
    // 落とすときは必ず閉じる方向に倒す。
    return deny('auth is not configured: ' + err.message)
  }

  if (host === AUTH_LABEL + '.' + domain) {
    return req.uri === CALLBACK_PATH ? callback(req, cfg, domain) : deny('not found')
  }

  const session = verify(cookie(req, COOKIE), cfg.session_secret)
  if (!session) return login(req, cfg, host, domain)

  // 認証済み。共有ベースと同じ規則で Host のラベルを S3 プレフィックスに写す
  // (previewbase.yaml の CloudFront Function と同じ内容。edge 構成では
  //  viewer-request に両方は付けられないので、こちらが兼ねる)
  req.uri = rewrite(host.split('.')[0], req.uri, cfg.mode, cfg.routing)
  return req
}

// --- OIDC ------------------------------------------------------------------

async function login(req, cfg, host, domain) {
  const n = nonce()
  const state = sign({ h: host, u: original(req), exp: now() + STATE_TTL, n }, cfg.session_secret)
  const binding = sign({ n, exp: now() + STATE_TTL }, cfg.session_secret)
  const url = new URL(cfg.authorization_endpoint)
  url.searchParams.set('response_type', 'code')
  url.searchParams.set('client_id', cfg.client_id)
  url.searchParams.set('redirect_uri', redirectURI(domain))
  url.searchParams.set('scope', cfg.scope || 'openid email')
  url.searchParams.set('state', state)
  url.searchParams.set('nonce', n)
  if (cfg.allowed_domain) url.searchParams.set('hd', cfg.allowed_domain)
  const response = redirect(url.toString())
  response.headers['set-cookie'] = [{
    key: 'Set-Cookie',
    value: `${STATE_COOKIE}=${binding}; Domain=.${domain}; Path=${CALLBACK_PATH}; Secure; HttpOnly; SameSite=Lax; Max-Age=${STATE_TTL}`,
  }]
  return response
}

async function callback(req, cfg, domain) {
  const q = new URLSearchParams(req.querystring || '')
  const code = q.get('code')
  const state = verify(q.get('state'), cfg.session_secret)
  const binding = verify(cookie(req, STATE_COOKIE), cfg.session_secret)
  if (!code || !state || !binding || !safeStringEqual(state.n, binding.n)) {
    return deny('invalid callback')
  }
  if (typeof state.h !== 'string' || !state.h.endsWith('.' + domain) ||
      typeof state.u !== 'string' || !state.u.startsWith('/') || state.u.startsWith('//')) {
    return deny('invalid callback target')
  }

  const res = await fetch(cfg.token_endpoint, {
    method: 'POST',
    headers: { 'content-type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({
      grant_type: 'authorization_code',
      code,
      redirect_uri: redirectURI(domain),
      client_id: cfg.client_id,
      client_secret: cfg.client_secret,
    }),
  })
  if (!res.ok) return deny('token exchange failed: ' + res.status)
  const token = await res.json()

  let claims
  try {
    claims = await verifyIDToken(token.id_token, cfg, state.n)
  } catch (err) {
    return deny('invalid id_token: ' + err.message)
  }
  // 誰でもログインできる IdP(Google の個人アカウント等)で全公開にしないため、
  // allowed_domain を設定していたらここで弾く。hd パラメータは省略可能な
  // ヒントでしかなく、これが最終的な関門になる。
  if (cfg.allowed_domain) {
    const email = String(claims.email || '')
    const allowed = cfg.allowed_domain.toLowerCase()
    const emailDomain = email.slice(email.lastIndexOf('@') + 1).toLowerCase()
    if (claims.email_verified !== true || String(claims.hd || '').toLowerCase() !== allowed ||
        !email.includes('@') || emailDomain !== allowed) {
      return deny('not allowed: ' + (email || 'unknown'))
    }
  }

  const session = sign({ s: claims.sub, e: claims.email, exp: now() + SESSION_TTL }, cfg.session_secret)
  return {
    status: '302',
    headers: {
      location: [{ key: 'Location', value: 'https://' + state.h + state.u }],
      'set-cookie': [{
        key: 'Set-Cookie',
        // Domain=.<domain> で全プレビュー環境に効かせる(環境ごとに
        // ログインし直させない)。Secure/HttpOnly は常に付ける。
        value: `${COOKIE}=${session}; Domain=.${domain}; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=${SESSION_TTL}`,
      }, {
        key: 'Set-Cookie',
        value: `${STATE_COOKIE}=; Domain=.${domain}; Path=${CALLBACK_PATH}; Secure; HttpOnly; SameSite=Lax; Max-Age=0`,
      }],
      'cache-control': [{ key: 'Cache-Control', value: 'no-store' }],
    },
  }
}

function redirectURI(domain) {
  return 'https://' + AUTH_LABEL + '.' + domain + CALLBACK_PATH
}

// --- 設定(SSM)-------------------------------------------------------------

// configFor は /kagerou/edge-auth/<domain>/ 以下を 1 回で読む。
// 非機密(mode / routing)はベースのテンプレートが書き、機密(client_secret /
// session_secret)は人が SecureString で置く。両方ここに集まる。
function configFor(domain) {
  if (!configs.has(domain)) {
    configs.set(domain, load(domain).catch((err) => {
      configs.delete(domain) // 失敗をコンテナの寿命ぶん引きずらない
      throw err
    }))
  }
  return configs.get(domain)
}

async function load(domain) {
  const prefix = `/kagerou/edge-auth/${domain}/`
  const out = {}
  let token
  do {
    const page = await ssm.send(new GetParametersByPathCommand({
      Path: prefix, WithDecryption: true, NextToken: token,
    }))
    for (const p of page.Parameters || []) out[p.Name.slice(prefix.length)] = p.Value
    token = page.NextToken
  } while (token)

  for (const k of ['issuer', 'client_id', 'client_secret', 'session_secret']) {
    if (!out[k]) throw new Error(`${prefix}${k} is not set`)
  }
  if (!isHTTPS(out.issuer)) throw new Error('issuer must be an https URL')
  const disco = await fetch(out.issuer.replace(/\/$/, '') + '/.well-known/openid-configuration')
  if (!disco.ok) throw new Error('discovery failed: ' + disco.status)
  const meta = await disco.json()
  if (meta.issuer !== out.issuer) throw new Error('discovery issuer does not match configured issuer')
  for (const k of ['authorization_endpoint', 'token_endpoint', 'jwks_uri']) {
    if (!isHTTPS(meta[k])) throw new Error(`discovery ${k} must be an https URL`)
  }
  const supported = Array.isArray(meta.id_token_signing_alg_values_supported)
    ? meta.id_token_signing_alg_values_supported.filter((alg) => ALLOWED_ALGS.has(alg))
    : []
  if (supported.length === 0) throw new Error('discovery has no supported ID token signing algorithm')
  out.issuer = meta.issuer
  out.authorization_endpoint = meta.authorization_endpoint
  out.token_endpoint = meta.token_endpoint
  out.jwks_uri = meta.jwks_uri
  out.allowed_algs = new Set(supported)
  await refreshJWKS(out)
  return out
}

function isHTTPS(value) {
  try {
    return new URL(value).protocol === 'https:'
  } catch {
    return false
  }
}

async function refreshJWKS(cfg) {
  const res = await fetch(cfg.jwks_uri)
  if (!res.ok) throw new Error('jwks fetch failed: ' + res.status)
  const body = await res.json()
  if (!Array.isArray(body.keys)) throw new Error('jwks has no keys array')
  cfg.jwks = body.keys
  cfg.jwks_loaded_at = now()
}

async function signingKey(cfg, kid, alg) {
  if (!cfg.jwks || cfg.jwks_loaded_at + JWKS_TTL < now()) await refreshJWKS(cfg)
  let keys = cfg.jwks.filter((key) => key.kid === kid)
  if (keys.length === 0) {
    // IdP の鍵ローテーション直後は、cold start 時のJWKSに新しいkidが無い。
    await refreshJWKS(cfg)
    keys = cfg.jwks.filter((key) => key.kid === kid)
  }
  if (keys.length !== 1) throw new Error('signing key not found or ambiguous')
  const key = keys[0]
  if (key.kty !== 'RSA' || (key.use && key.use !== 'sig') ||
      (key.alg && key.alg !== alg) || (key.key_ops && !key.key_ops.includes('verify'))) {
    throw new Error('signing key is not valid for ID token verification')
  }
  return createPublicKey({ key, format: 'jwk' })
}

async function verifyIDToken(jwt, cfg, expectedNonce) {
  const parts = String(jwt || '').split('.')
  if (parts.length !== 3 || parts.some((part) => !part)) throw new Error('malformed JWT')

  let header
  let claims
  try {
    header = JSON.parse(Buffer.from(parts[0], 'base64url').toString())
    claims = JSON.parse(Buffer.from(parts[1], 'base64url').toString())
  } catch {
    throw new Error('malformed JWT JSON')
  }
  if (!cfg.allowed_algs.has(header.alg) || !ALLOWED_ALGS.has(header.alg) || typeof header.kid !== 'string') {
    throw new Error('disallowed alg or missing kid')
  }

  const key = await signingKey(cfg, header.kid, header.alg)
  const valid = verifySignature(
    'RSA-SHA256',
    Buffer.from(parts[0] + '.' + parts[1]),
    key,
    Buffer.from(parts[2], 'base64url'),
  )
  if (!valid) throw new Error('signature verification failed')

  const t = now()
  if (claims.iss !== cfg.issuer) throw new Error('issuer mismatch')
  const audiences = typeof claims.aud === 'string' ? [claims.aud] : claims.aud
  if (!Array.isArray(audiences) || !audiences.includes(cfg.client_id)) throw new Error('audience mismatch')
  if ((audiences.length > 1 && typeof claims.azp !== 'string') ||
      (claims.azp !== undefined && claims.azp !== cfg.client_id)) {
    throw new Error('authorized party mismatch')
  }
  if (!Number.isInteger(claims.exp) || claims.exp <= t - CLOCK_SKEW) throw new Error('token expired')
  if (!Number.isInteger(claims.iat) || claims.iat > t + CLOCK_SKEW || claims.iat < t - MAX_TOKEN_AGE ||
      claims.exp <= claims.iat) {
    throw new Error('invalid issued-at time')
  }
  if (typeof claims.sub !== 'string' || !claims.sub) throw new Error('missing subject')
  if (!safeStringEqual(claims.nonce, expectedNonce)) throw new Error('nonce mismatch')
  return claims
}

// --- 署名付きの値 ----------------------------------------------------------

// sign / verify は「CloudFront の前で完結する署名付きトークン」。JWT ライブラリを
// 持ち込まないのは、Lambda@Edge に依存を積むと 5 秒の予算を cold start で削るため。
function sign(payload, secret) {
  const body = b64url(Buffer.from(JSON.stringify(payload)))
  return body + '.' + hmac(body, secret)
}

function verify(value, secret) {
  if (!value) return null
  const dot = value.lastIndexOf('.')
  if (dot < 0) return null
  const body = value.slice(0, dot)
  const got = Buffer.from(value.slice(dot + 1))
  const want = Buffer.from(hmac(body, secret))
  if (got.length !== want.length || !timingSafeEqual(got, want)) return null
  try {
    const payload = JSON.parse(Buffer.from(body, 'base64url').toString())
    return payload.exp > now() ? payload : null
  } catch {
    return null
  }
}

function hmac(body, secret) {
  return b64url(createHmac('sha256', secret).update(body).digest())
}

function b64url(buf) {
  return buf.toString('base64url')
}

function nonce() {
  return b64url(randomBytes(16))
}

function safeStringEqual(left, right) {
  if (typeof left !== 'string' || typeof right !== 'string') return false
  const a = Buffer.from(left)
  const b = Buffer.from(right)
  return a.length === b.length && timingSafeEqual(a, b)
}

function now() {
  return Math.floor(Date.now() / 1000)
}

// --- CloudFront の小道具 ---------------------------------------------------

function header(req, name) {
  const h = req.headers[name]
  return h && h[0] ? h[0].value : ''
}

function cookie(req, name) {
  for (const h of req.headers.cookie || []) {
    for (const part of h.value.split(';')) {
      const [k, ...v] = part.trim().split('=')
      if (k === name) return v.join('=')
    }
  }
  return ''
}

function original(req) {
  return req.uri + (req.querystring ? '?' + req.querystring : '')
}

// rewrite は previewbase.yaml の CloudFront Function と同じ規則。
// 片方だけ直すと「認証ありだけディープリンクが 403」になるので、
// 変更するときは必ず両方を直すこと。
function rewrite(label, uri, mode, routing) {
  let prefix = label
  if (mode === 'shared') {
    const sep = label.indexOf('--')
    if (sep >= 0) prefix = label.slice(0, sep) + '/' + label.slice(sep + 2)
  }
  if (uri.endsWith('/')) {
    uri += 'index.html'
  } else if (!uri.split('/').pop().includes('.')) {
    uri = routing === 'spa' ? '/index.html' : uri + '/index.html'
  }
  return '/' + prefix + uri
}

function redirect(location) {
  return {
    status: '302',
    headers: {
      location: [{ key: 'Location', value: location }],
      'cache-control': [{ key: 'Cache-Control', value: 'no-store' }],
    },
  }
}

function deny(reason) {
  return {
    status: '403',
    headers: {
      'content-type': [{ key: 'Content-Type', value: 'text/plain; charset=utf-8' }],
      'cache-control': [{ key: 'Cache-Control', value: 'no-store' }],
    },
    body: 'kagerou: ' + reason + '\n',
  }
}
