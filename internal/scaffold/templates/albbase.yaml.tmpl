AWSTemplateFormatVersion: "2010-09-09"
Description: >
  kagerou ALB base — the entrypoint for one app's preview environments.
  Deploy ONCE per app (project), in the app's region (unlike the CloudFront base,
  which lives in us-east-1). Environments only add a listener rule and a target
  group (both free); the ALB itself carries the fixed monthly cost.

  per-app なのは、チームごとに使うから 1 本では足りなくなるため(リスナールールは
  既定 100 本、証明書は 25 枚の上限もある)。1 本を全アプリで共有したい場合は
  Project に _shared-alb を渡せば、その名前空間に SSM が書かれる(DESIGN §11.3)。

  デプロイ(アプリごとに 1 回、アプリのリージョンで):
    aws cloudformation deploy --stack-name kagerou-alb-base-<project> \\
      --template-file deploy/alb-base.yaml \\
      --parameter-overrides Project=<project> DomainName=<project>.example.com \\
        HostedZoneId=<zone> VpcId=<vpc> SubnetIds=<subnet-a>,<subnet-b>

Parameters:
  Project:
    Type: String
    AllowedPattern: "[a-z_]([a-z0-9_-]*[a-z0-9])?"
    Description: kagerou project name; namespaces the SSM contract and every resource
  DomainName:
    Type: String
    Description: This app's preview domain, e.g. todo.example.com (URLs become pr-42.todo.example.com)
  HostedZoneId:
    Type: AWS::Route53::HostedZone::Id
  VpcId:
    Type: AWS::EC2::VPC::Id
  SubnetIds:
    Type: List<AWS::EC2::Subnet::Id>
    Description: Public subnets for the ALB (at least two AZs)
  # タスクを既存のプライベートサブネットに置きたいとき(public IP 禁止ポリシー、
  # NAT 経由 egress の本番乖離を縮めたい等)に指定する。kagerou が NAT を作る
  # ことはない — チームが既に持っている構成に「乗る」だけ。
  # 省略時は従来どおり ALB と同じパブリックサブネット + public IP。
  TaskSubnetIds:
    Type: String
    Default: ""
    Description: >
      Optional comma-separated PRIVATE subnet ids for tasks (must have NAT or the
      needed VPC endpoints for ECR/Logs). Empty = reuse SubnetIds with a public IP.

Conditions:
  HasTaskSubnets: !Not [!Equals [!Ref TaskSubnetIds, ""]]

Resources:
  Certificate:
    Type: AWS::CertificateManager::Certificate
    Properties:
      DomainName: !Sub "*.${DomainName}"
      ValidationMethod: DNS
      DomainValidationOptions:
        - DomainName: !Sub "*.${DomainName}"
          HostedZoneId: !Ref HostedZoneId

  AlbSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: kagerou shared ALB (public HTTPS)
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          CidrIp: 0.0.0.0/0

  # 環境のタスクはこの SG を付ける。ALB からのみ到達でき、環境同士は繋がらない
  TaskSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: kagerou preview tasks (from the shared ALB only)
      VpcId: !Ref VpcId

  TaskIngressFromAlb:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref TaskSecurityGroup
      IpProtocol: tcp
      FromPort: 0
      ToPort: 65535
      SourceSecurityGroupId: !Ref AlbSecurityGroup

  LoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Type: application
      Scheme: internet-facing
      Subnets: !Ref SubnetIds
      SecurityGroups: [!Ref AlbSecurityGroup]

  # 既定は 404。環境ごとのリスナールールが自分のホスト名を横取りする
  Listener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn: !Ref LoadBalancer
      Port: 443
      Protocol: HTTPS
      Certificates:
        - CertificateArn: !Ref Certificate
      DefaultActions:
        - Type: fixed-response
          FixedResponseConfig:
            StatusCode: "404"
            ContentType: text/plain
            MessageBody: no kagerou environment for this host

  Cluster:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: !Sub "kagerou-preview-${Project}"

  WildcardRecord:
    Type: AWS::Route53::RecordSet
    Properties:
      HostedZoneId: !Ref HostedZoneId
      Name: !Sub "*.${DomainName}"
      Type: A
      AliasTarget:
        DNSName: !GetAtt LoadBalancer.DNSName
        HostedZoneId: !GetAtt LoadBalancer.CanonicalHostedZoneID

  # ベース↔環境のデータ契約(CONTRACT §9 の compute 版)
  SsmDomain:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/domain"
      Type: String
      Value: !Ref DomainName
  SsmListener:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_listener_arn"
      Type: String
      Value: !Ref Listener
  SsmCluster:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_cluster"
      Type: String
      Value: !Ref Cluster
  SsmVpc:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_vpc_id"
      Type: String
      Value: !Ref VpcId
  SsmSubnets:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_subnets"
      Type: StringList
      # タスクが使うサブネット。TaskSubnetIds があればそちら(プライベート運用)
      Value: !If [HasTaskSubnets, !Ref TaskSubnetIds, !Join [",", !Ref SubnetIds]]
  SsmAssignPublicIp:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_assign_public_ip"
      Type: String
      # プライベートサブネットなら public IP を付けない(付けても意味がなく、
      # 組織ポリシーで禁止されていることも多い)
      Value: !If [HasTaskSubnets, "DISABLED", "ENABLED"]
  SsmTaskSg:
    Type: AWS::SSM::Parameter
    Properties:
      Name: !Sub "/kagerou/base/${Project}/alb_task_security_group"
      Type: String
      Value: !Ref TaskSecurityGroup

Outputs:
  Domain:
    Value: !Ref DomainName
  ListenerArn:
    Value: !Ref Listener
  ClusterName:
    Value: !Ref Cluster
  TaskSecurityGroup:
    Value: !Ref TaskSecurityGroup
  Subnets:
    Value: !Join [",", !Ref SubnetIds]
