#!/usr/bin/env sh
{{generatedBy "#"}}
# AWS + GitHub setup for kagerou previews (generated by kagerou init).
# Review before running. Requires: kagerou, aws CLI (logged in), and gh CLI.
set -eu

OWNER="{{.Owner}}"
REPO="{{.Repo}}"
REGION="{{.Region}}"
PROJECT="{{.Project}}"
ROLE="${REPO}-github-actions"
BOUNDARY_NAME="${PROJECT}-boundary"
INLINE_POLICY_NAME="kagerou-deploy"
KAGEROU_BIN="${KAGEROU_BIN:-kagerou}"

if [ -z "$OWNER" ] || [ -z "$REPO" ]; then
  echo "error: could not detect the GitHub repository; edit OWNER/REPO at the top of this script" >&2
  exit 1
fi

ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
BOUNDARY_ARN="arn:aws:iam::${ACCOUNT}:policy/${BOUNDARY_NAME}"

if ! command -v "$KAGEROU_BIN" >/dev/null 2>&1; then
  echo "error: kagerou is required to generate the IAM documents (set KAGEROU_BIN if it is not on PATH)" >&2
  exit 1
fi

# GitHub OIDC provider (one per AWS account; create only if missing)
PROVIDER_ARN="arn:aws:iam::${ACCOUNT}:oidc-provider/token.actions.githubusercontent.com"
aws iam get-open-id-connect-provider --open-id-connect-provider-arn "$PROVIDER_ARN" >/dev/null 2>&1 || \
  aws iam create-open-id-connect-provider \
    --url https://token.actions.githubusercontent.com \
    --client-id-list sts.amazonaws.com \
    --thumbprint-list 1c58a3a8518e8759bf075b76b750d4f2df264fcd >/dev/null

# Generate the hardened IAM documents from the same implementation as
# `kagerou iam-policy`: least privilege, limited OIDC contexts, and a recursive
# permissions boundary. Re-running this script migrates an older admin role.
REPO_ID=$(gh api "repos/${OWNER}/${REPO}" --jq .id)
OWNER_ID=$(gh api "repos/${OWNER}/${REPO}" --jq .owner.id)
IAM_DIR=$(mktemp -d "${TMPDIR:-/tmp}/kagerou-iam.XXXXXX")
trap 'rm -rf "$IAM_DIR"' EXIT
TRUST_FILE="$IAM_DIR/trust.json"
BOUNDARY_FILE="$IAM_DIR/boundary.json"
POLICY_FILE="$IAM_DIR/policy.json"
POLICY_CONFIG="$IAM_DIR/kagerou-policy.yaml"
{{- if .Static}}
BASE_BUCKET="{{.BaseBucket}}"
if [ -z "$BASE_BUCKET" ]; then
  BASE_BUCKET="kagerou-base-${PROJECT}-${ACCOUNT}"
fi
{{- end}}

# Use a complete, setup-only config. The repository config can intentionally
# still contain onboarding TODOs (for example static.bucket or auth.secret_arn),
# but that must not force users back to AdministratorAccess.
cat > "$POLICY_CONFIG" <<EOF
project: ${PROJECT}
driver: {{if .Static}}static{{else}}stack{{end}}
{{- if not .Static}}
template: template.yaml
{{- end}}
region: ${REGION}
name_prefix: ${PROJECT}-
ttl: 72h
{{- if .Static}}
url_template: "https://{name}.example.invalid"
static:
  dist: .
  bucket: ${BASE_BUCKET}
{{- else if .DomainFromSSM}}
url_template: "https://{name}.{base_domain}"
{{- end}}
EOF

BOUNDARY_REGIONS="$REGION"
{{- if or .Static .Auth}}
# Static delivery and Lambda@Edge live in us-east-1 even when the app does not.
BOUNDARY_REGIONS="${REGION},us-east-1"
{{- end}}

"$KAGEROU_BIN" iam-policy --doc trust --repo "${OWNER}/${REPO}" \
  --account "$ACCOUNT" --owner-id "$OWNER_ID" --repo-id "$REPO_ID" > "$TRUST_FILE"
"$KAGEROU_BIN" iam-policy --doc boundary --config "$POLICY_CONFIG" \
  --account "$ACCOUNT" --regions "$BOUNDARY_REGIONS" > "$BOUNDARY_FILE"
{{- if .Static}}
"$KAGEROU_BIN" iam-policy --config "$POLICY_CONFIG" \
  --base-bucket "$BASE_BUCKET" > "$POLICY_FILE"
{{- else}}
"$KAGEROU_BIN" iam-policy --config "$POLICY_CONFIG" \
  --with-ecr --ecr-repo "$REPO" > "$POLICY_FILE"
{{- end}}

# A permissions boundary must be a managed policy. Keep one fresh non-default
# version at most, so repeated setup never hits IAM's five-version limit.
if aws iam get-policy --policy-arn "$BOUNDARY_ARN" >/dev/null 2>&1; then
  for VERSION_ID in $(aws iam list-policy-versions --policy-arn "$BOUNDARY_ARN" \
    --query 'Versions[?IsDefaultVersion==`false`].VersionId' --output text); do
    aws iam delete-policy-version --policy-arn "$BOUNDARY_ARN" --version-id "$VERSION_ID"
  done
  aws iam create-policy-version --policy-arn "$BOUNDARY_ARN" \
    --policy-document "file://$BOUNDARY_FILE" --set-as-default >/dev/null
else
  aws iam create-policy --policy-name "$BOUNDARY_NAME" \
    --policy-document "file://$BOUNDARY_FILE" >/dev/null
fi

if aws iam get-role --role-name "$ROLE" >/dev/null 2>&1; then
  aws iam update-assume-role-policy --role-name "$ROLE" \
    --policy-document "file://$TRUST_FILE"
  aws iam put-role-permissions-boundary --role-name "$ROLE" \
    --permissions-boundary "$BOUNDARY_ARN"
else
  aws iam create-role --role-name "$ROLE" \
    --assume-role-policy-document "file://$TRUST_FILE" \
    --permissions-boundary "$BOUNDARY_ARN" \
    --description "GitHub Actions OIDC role for ${OWNER}/${REPO} (kagerou previews)" >/dev/null
fi
aws iam put-role-policy --role-name "$ROLE" --policy-name "$INLINE_POLICY_NAME" \
  --policy-document "file://$POLICY_FILE"

# Migration from setup scripts generated before #236. Do this last, after the
# replacement policy and boundary are in place; failure must stop the script.
ADMIN_ARN="arn:aws:iam::aws:policy/AdministratorAccess"
ATTACHED_ADMIN=$(aws iam list-attached-role-policies --role-name "$ROLE" \
  --query "AttachedPolicies[?PolicyArn=='${ADMIN_ARN}'].PolicyArn | [0]" --output text)
if [ "$ATTACHED_ADMIN" = "$ADMIN_ARN" ]; then
  aws iam detach-role-policy --role-name "$ROLE" --policy-arn "$ADMIN_ARN"
fi

# ECR repository (push target for sam package)
aws ecr describe-repositories --repository-names "$REPO" --region "$REGION" >/dev/null 2>&1 || \
  aws ecr create-repository --repository-name "$REPO" --region "$REGION" >/dev/null

# GitHub repository variables
gh variable set AWS_ROLE_ARN   --body "arn:aws:iam::${ACCOUNT}:role/${ROLE}"
gh variable set AWS_REGION     --body "${REGION}"
gh variable set ECR_REPOSITORY --body "${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com/${REPO}"

{{- if .Base}}

# --- 共有ベースの情報(以下のブロックで使う) ---
# ベースは「環境より長生きする入口」で、アプリごとに 1 回だけ用意する。
# テンプレートはこのリポジトリにあるので、後から誰でも deploy し直せる(冪等)。
DOMAIN="{{.Domain}}"
PARENT="${DOMAIN#*.}"
ZONE_ID=$(aws route53 list-hosted-zones-by-name --dns-name "$PARENT" \
  --query "HostedZones[?Name=='${PARENT}.'].Id | [0]" --output text 2>/dev/null | sed 's#/hostedzone/##') || ZONE_ID=""
if [ "$ZONE_ID" = "None" ]; then
  ZONE_ID=""
fi
ZONE_SHOW="${ZONE_ID:-<hosted zone id for ${PARENT}>}"
{{- end}}
{{- if and .SetupBase (not .Auth)}}

# Preview base — this app's shared CloudFront + wildcard certificate + DNS.
# One-time per app, in us-east-1 (CloudFront certificate constraint).
if [ -z "$ZONE_ID" ]; then
  echo "error: hosted zone for ${PARENT} not found" >&2
  exit 1
fi
echo "deploying preview base for *.${DOMAIN} (takes ~15 min: certificate validation + CloudFront)"
# タグを付けるのは `kagerou cost` が基盤の固定費を環境と分けて見るため
# (CONTRACT §1。コスト配分タグの有効化は Billing 側で 1 回だけ必要)
aws cloudformation deploy --region us-east-1 \
  --stack-name "kagerou-preview-base-${PROJECT}" \
  --template-file deploy/preview-base.yaml \
  --tags kagerou:managed=true kagerou:project="$PROJECT" kagerou:role=base \
  --parameter-overrides Project="$PROJECT" DomainName="$DOMAIN" HostedZoneId="$ZONE_ID" \
    Routing="{{.Routing}}"
{{- end}}
{{- if .ALB}}

# 共有 ALB のベース。**このスクリプトは deploy しない**: VPC とサブネットの id が
# 要り、そこはチームが既に持っているものに乗る話なので、勝手に選ばない。
cat <<EOS

next: 共有 ALB のベース(アプリごとに 1 回。既にあれば不要 — 相乗りできる)

  aws cloudformation deploy --stack-name kagerou-alb-base-${PROJECT} \\
    --template-file deploy/alb-base.yaml \\
    --tags kagerou:managed=true kagerou:project=${PROJECT} kagerou:role=base \\
    --parameter-overrides Project=${PROJECT} DomainName=${DOMAIN} \\
      HostedZoneId=${ZONE_SHOW} VpcId=<vpc> SubnetIds=<subnet-a>,<subnet-b>

  ALB 1 本で 月 \$18 前後の固定費。環境が増えても同額

EOS
{{- end}}
{{- if .APIGateway}}

# HTTP API + VPC Link のベース。ALB と同じ理由でここでは deploy しない。
cat <<EOS

next: 共有 VPC Link のベース(アプリごとに 1 回。固定費なし)

  aws cloudformation deploy --stack-name kagerou-apigw-base-${PROJECT} \\
    --template-file deploy/apigw-base.yaml \\
    --tags kagerou:managed=true kagerou:project=${PROJECT} kagerou:role=base \\
    --parameter-overrides Project=${PROJECT} DomainName=${DOMAIN} \\
      HostedZoneId=${ZONE_SHOW} VpcId=<vpc> SubnetIds=<subnet-a>,<subnet-b>

EOS
{{- end}}
{{- if .Auth}}

# Edge base — 認証つきの配信ベース(CloudFront + Lambda@Edge)。
#
# **このスクリプトは deploy しない。** 理由は 2 つ:
#   - Lambda@Edge のコード(deploy/edge-auth/)を同梱するのでパッケージが要る。
#     aws cloudformation deploy では上げられず sam が要る(このスクリプトの前提は
#     aws と gh だけ)
#   - client_secret は人が SecureString として置くもの。先に stack だけ作ると、
#     ログインが通らない入口が出来上がる
#
# 代わりに手順を出す。順番はこの通り(SSM を先に置く)。
cat <<EOS

next: 認証つきの配信ベース(一度だけ。us-east-1)

  1. OIDC の設定を SSM に置く(client_secret は SecureString)
     aws ssm put-parameter --region us-east-1 --type String --name /kagerou/edge-auth/${DOMAIN}/issuer --value https://accounts.google.com
     aws ssm put-parameter --region us-east-1 --type String --name /kagerou/edge-auth/${DOMAIN}/client_id --value <client id>
     aws ssm put-parameter --region us-east-1 --type SecureString --name /kagerou/edge-auth/${DOMAIN}/client_secret --value <client secret>
     aws ssm put-parameter --region us-east-1 --type SecureString --name /kagerou/edge-auth/${DOMAIN}/session_secret --value "\$(openssl rand -base64 32)"
{{- if .AuthDomain}}
     aws ssm put-parameter --region us-east-1 --type String --name /kagerou/edge-auth/${DOMAIN}/allowed_domain --value {{.AuthDomain}}
{{- end}}

  2. ベースを deploy する(証明書の検証と配信開始で 15 分ほど)
     sam deploy --template-file deploy/edge-base.yaml --region us-east-1 \\
       --stack-name kagerou-edge-base-${PROJECT} --capabilities CAPABILITY_NAMED_IAM \\
       --resolve-s3 --parameter-overrides Project=${PROJECT} DomainName=${DOMAIN} \\
         HostedZoneId=${ZONE_SHOW} Routing={{.Routing}}

  3. IdP に redirect_uri を 1 本だけ登録する
     https://auth.${DOMAIN}/_kagerou/auth/callback

EOS
{{- end}}

echo "done:"
echo "  role  arn:aws:iam::${ACCOUNT}:role/${ROLE}"
echo "  ecr   ${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com/${REPO}"
echo "  vars  AWS_ROLE_ARN / AWS_REGION / ECR_REPOSITORY"
{{- if and .Domain .BaseReady}}
echo "  base  https://<name>.{{.Domain}} (routing: {{.Routing}})"
{{- else if .Domain}}
echo "  base  未作成 — 上の next: を済ませると https://<name>.{{.Domain}} が開く"
{{- end}}
